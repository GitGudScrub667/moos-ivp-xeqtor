//*******************************************************
// FILE: meta_shoreside.moos   (skara_N_boats - Skaramangas cove)
//   Shoreside community: viewer + broker + node-comms relay.
//*******************************************************

ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community  = shoreside

#include plugs.moos <origin_warp>

//--------------------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 100

  Run = MOOSDB          @ NewConsole = false
  Run = pMarineViewer   @ NewConsole = false
  Run = pLogger         @ NewConsole = false
  Run = uProcessWatch   @ NewConsole = false
  Run = pShare          @ NewConsole = false
  Run = pHostInfo       @ NewConsole = false
  Run = uFldShoreBroker @ NewConsole = false
  Run = uFldNodeComms   @ NewConsole = false
  Run = pArrivalSync    @ NewConsole = false
  Run = pRealm          @ NewConsole = false
  Run = uTimerScript    @ NewConsole = false
}

//--------------------------------------------------
// uTimerScript config block
//   Beats HEARTBEAT_ALL once a second. qbridge below relays it to every
//   boat as HEARTBEAT, where pDeadManPost (hardware builds only) watches
//   it: if the link drops for max_noheart seconds the boat un-deploys and
//   all-stops. Harmless in sim -- nothing subscribes.

ProcessConfig = uTimerScript
{
  AppTick   = 4
  CommsTick = 4

  paused     = false
  reset_max  = unlimited
  reset_time = all-posted

  event = var=HEARTBEAT_ALL, val=true, time=1
}

#include plugs.moos <pShare>
#include plugs.moos <pHostInfo>
#include plugs.moos <uProcessWatch>

//--------------------------------------------------
// uFldShoreBroker config block
//   qbridge FOO  ==  bridge src=FOO_$V alias=FOO  +  src=FOO_ALL alias=FOO

ProcessConfig = uFldShoreBroker
{
  AppTick   = 1
  CommsTick = 1

  qbridge = DEPLOY, RETURN, STATION_KEEP
  qbridge = NODE_REPORT, NODE_MESSAGE
  qbridge = MOOS_MANUAL_OVERRIDE, APPCAST_REQ
  qbridge = SLOT_UPDATE
  // RETURN_UPDATE carries the center-detour route home (pArrivalSync posts
  // RETURN_UPDATE_<VNAME>; waypt_return subscribes to RETURN_UPDATE). Without
  // this bridge the shoreside computes the route correctly and the boat never
  // hears it -- the helm registers for the variable but no value ever arrives,
  // so waypt_return keeps the single baked-in RETURN_POS and beelines home
  // straight across the show vessel. Every other *_UPDATE below is bridged for
  // the same reason; RETURN_UPDATE was the one that had no publisher until the
  // center-detour was added.
  qbridge = RETURN_UPDATE
  qbridge = ENCIRCLE_UPDATE
  qbridge = DISPERSE, DISPERSE_UPDATE
  qbridge = MIO, MIO_UPDATE
  qbridge = SLOTTED
  qbridge = HEARTBEAT       // -> pDeadManPost on each boat (hardware)
}

//--------------------------------------------------
// uFldNodeComms config block
//   Relays each vehicle's NODE_REPORT to the others so the
//   per-vehicle contact manager + COLREGS avoidance can see
//   neighbours. comms_range set large: the whole cove is small.

ProcessConfig = uFldNodeComms
{
  AppTick   = 2
  CommsTick = 2

  comms_range      = 500
  critical_range   = 25
  min_msg_interval = 0
  max_msg_length   = 1000

  view_node_rpt_pulses = false
}

//--------------------------------------------------
// pArrivalSync config block
//   (1) run-in: commands each boat's speed so both reach their ring
//       slots at the same time (staggered, farthest first).
//   (2) orbit phase-lock: once arrived, each boat tracks a virtual point
//       sweeping the ring at omega=orbit_speed/radius, phase = its slot
//       angle. Speed is modulated to null its own phase error -> exactly
//       even 180-deg spacing, no inter-boat coupling.
//   Slots MUST match the goto_slot points in meta_vehicle.bhv and the
//   ring in the encircle behavior (init_field.sh vslotpos / launch_vehicle CIRCLE_*).

ProcessConfig = pArrivalSync
{
  AppTick   = 4
  CommsTick = 4

  max_speed        = 2.42    // pireas 2.1 x1.15 (water-tested safe headroom)
  min_speed        = 0.32    // pireas 0.28 x1.15
  min_arrival_time = 8
  capture_dist     = 6
  stagger_time     = 5     // secs between boat releases (farthest first)

  deploy_var = DEPLOY_ALL
  return_var = RETURN_ALL
  update_var = SLOT_UPDATE

  // Skaramangas show geometry (placed on the skara chart 2026-07-29). Ring is
  // the primary anchor; the DISPERSE square + the show_vessel/mio_nogo obstacle
  // polygons (meta_vehicle.bhv) derive from the ring + MIO. MUST match the
  // CIRCLE_X/Y/RAD drawn in launch_vehicle.sh.
  enable_orbit_lock = true
  circle_x    = 55        // ring center (55,-50), r33 -- central Skaramangas basin
  circle_y    = -50
  circle_rad  = 33
  orbit_speed = 1.61      // pireas 1.4 x1.15
  orbit_gain  = 0.03      // m/s of speed correction per degree of phase error
  orbit_min   = 0.81      // pireas 0.7 x1.15
  orbit_max   = 2.82      // pireas 2.45 x1.15 (re-spacing catch-up headroom)
  orbit_var   = ENCIRCLE_UPDATE

  // DISPERSE / ASSEMBLE square formation. Square centred on the ring
  // (55,-50), half-side 37.95 (= 1.15 * ring_radius 33), ROTATED 45 deg so the
  // four corners now lie due N / W / S / E of the ring center at the square's
  // circumradius 53.67 (= 37.95 * sqrt(2)) instead of on the diagonals.
  // It still CONTAINS the r=33 ring and its corners sit outside the ring for
  // the outward disperse. Corner order stays CCW (N,W,S,E) so the forward-bias
  // + cyclicAssign non-crossing assignment behave as before. On DISPERSE each
  // boat takes its nearest corner and holds a square_radius circle on it.
  enable_disperse   = true
  square            = 55,3.67:1.33,-50:55,-103.67:108.67,-50
  square_radius     = 8        // turn-radius floor; NOT scaled with the formation
  disperse_speed    = 1.61     // pireas 1.4 x1.15
  disperse_cmd_var  = DISPERSE_CMD
  // Forward-bias for BOTH transitions, broken on the nearest-target tie:
  //  - DISPERSE: each boat peels off to the corner AHEAD in the orbit (CCW)
  //    direction (tangent exit) instead of turning back across the ring.
  //  - ASSEMBLE: each boat gets the ring slot it can ENTER moving forward, so
  //    it slides onto the orbit tangentially instead of reaching the ring and
  //    U-turning inward toward the centre no-go zone.
  // Still non-crossing, no two boats share a target. disperse_fwd_penalty
  // (default 0.4) tunes how hard it prefers forward; raise if a boat reverses.
  disperse_forward_bias = true
  disperse_fwd_penalty  = 3.0      // raised from default 0.4: push a just-passed-corner boat to the corner AHEAD so it enters the CCW loiter tangentially (no U-turn loop)

  // Retransmit: a DISPERSE/ASSEMBLE/MIO/END-MIO command is a single MOOS var
  // over the field radio, and on the water one can be dropped -- a boat then
  // stays in the old formation (seen on the 27-Jul 4-boat run: sometimes only
  // 3 of 4 dispersed). For reassert_secs after each command the shoreside
  // re-posts the cached per-boat flags every reassert_interval, so a dropped
  // packet self-heals with no button dance. Covers DISPERSE/ASSEMBLE (all
  // boats) and MIO/END-MIO (the one station boat). Every re-post is idempotent
  // (the ring re-form re-post is guarded by per-boat arrival, so a settled boat
  // is never kicked off the ring). 0 => off. A repeat same-direction press also
  // re-asserts.
  reassert_secs     = 5
  reassert_interval = 1

  // MIO station. On the MIO button the closest boat leaves the ring, holds an
  // r=mio_radius loiter around this fixed point, and the other boat keeps
  // orbiting alone; END MIO recalls it and the two re-form 180 deg apart.
  // MIO station: local (25,-100), ~58 m SSW of the ring center in open water,
  // clear of the r33 ring (25 m outside it) and outside the DISPERSE square.
  // The 4.4 m no-go at the centre is a static obstacle in meta_vehicle.bhv
  // (mio_nogo, centred here -- keep the two in sync).
  enable_mio  = true
  mio_x       = 25
  mio_y       = -100
  mio_radius  = 7.7      // pireas 7 x1.1 (guard loiter around the station object)
  mio_speed   = 1.61     // pireas 1.4 x1.15
  mio_cmd_var = MIO_CMD

  //---------------------------------------------------------------
  // CENTER DETOUR (opt-in; default off, so pireas_N_boat and the other
  // missions sharing pArrivalSync are unaffected).
  //
  // The boats ring the show vessel but all launch from the one south beach,
  // so a boat slotted on the far (north) side would run straight across the
  // middle -- through the parked vessel -- both on the way out and on the way
  // home. With this on, any transit whose straight line would pass within
  // detour_radius of the ring centre is re-routed around it, on an arc of
  // waypoints walked COUNTER-CLOCKWISE (the same sense as the orbit) so that
  // boats transiting at the same time follow one another instead of picking
  // opposite sides and meeting head-on.
  //
  // detour_radius must sit in the gap between the show_vessel avoidance
  // envelope and the ring: the envelope reaches 22.0 m from the centre (11 m
  // octagon + pwt_outer_dist 11) and the ring is at 33. 26 leaves 4 m outside
  // the envelope and 7 m inside the orbit.
  //
  // detour_max_leg_deg caps how much arc a single straight leg may span. This
  // matters: the boat flies straight lines between waypoints, so a long chord
  // across the keep-out circle sags back INSIDE it. One waypoint on the far
  // side is not enough -- measured, it sagged to 20.0 m (N=4) and 14.7 m
  // (N=5), i.e. back inside the envelope. At 45 deg the worst measured
  // clearance over every home/slot pair is 24.05 m (N=4) / 24.30 m (N=5),
  // clearing both the 11 m obstacle and the 22 m envelope. Cost is a 4-13%
  // longer run-in (up to +44% for the far slot at N=5).
  //
  // NOTE: the run-in stays SYNCHRONISED. pArrivalSync measures each boat's
  // REMAINING PATH LENGTH via whichever detour waypoints are still ahead of
  // it, so the detoured boat becomes the pace-setter (it runs at max_speed)
  // and every other boat is slowed to the same common arrival time. The
  // farthest-first release stagger uses the same path length. Verified: all
  // boats land together, with the slowest at 1.09 m/s -- still above min_speed.
  enable_center_detour = true
  detour_radius        = 26
  detour_max_leg_deg   = 45

  // Per-boat home / return points, for planning the route home. Injected by
  // launch.sh from vnames.txt + vpositions.txt -- the SAME files that give
  // launch_vehicle.sh its RETURN_POS -- so the shoreside can never drift from
  // what the boats actually use. Format: name,x,y:name,x,y:...
#ifdef HOMES
  homes = $(HOMES)
#endif

  // Dynamic roster (skara_N_boats): no fixed 'vehicle=' slots. On each fresh
  // DEPLOY, pArrivalSync snapshots which pool boats are connected (a node
  // report within roster_timeout secs), caps at max_boats, and lays N slots
  // EVENLY around the ring (slot 0 at slot_base_deg=E, the rest at +i*360/N),
  // assigning them non-crossing. RETURN + re-DEPLOY re-locks for whatever set
  // is present then -- boats can be added/dropped with no relaunch.
  //   N=1 -> encircle solo;  N=2 -> E/W;  N=3 -> 120 deg;  N=4 -> cardinals.
  enable_dynamic_roster = true
  roster_pool    = asha,bama,chip,flex,ewan
  max_boats      = 4
  slot_base_deg  = 0        // slot 0 due East of the ring centre
  roster_timeout = 5        // secs; a boat quiet longer than this is "not present"
}

//--------------------------------------------------
// pLogger config block

ProcessConfig = pLogger
{
  AppTick   = 10
  CommsTick = 10

  File          = XLOG_SHORESIDE
  PATH          = ./
  AsyncLog      = true
  FileTimeStamp = true
  LogAuxSrc     = true

  WildCardLogging = true
  WildCardOmitPattern = *_STATUS
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = DB_RWSUMMARY
  WildCardOmitPattern = *_ITER_GAP
  WildCardOmitPattern = *_ITER_LEN
}

//--------------------------------------------------------
// pMarineViewer config block  (Skaramangas cove chart)

ProcessConfig = pMarineViewer
{
  AppTick    = 4
  CommsTick  = 4

  tiff_file            = skaramangas.tif

  // TODO(skara geometry): pan/zoom are skara3_2's defaults as a starting point;
  // retune once the show formation is placed so it sits centred in the view.
  set_pan_x            = 0
  set_pan_y            = 0
  zoom                 = 0.85
  vehicles_shape_scale = 1.5
  vehicles_name_mode   = names

  // NOTE: the live-viewer icon jitter on the greece field radio is still an
  // OPEN issue. A previous attempt -- a core ContactLedger out-of-order guard
  // patched into ~/moos-ivp, paired with `extrap_policy = mode=cog, decay=2:5`
  // here -- did NOT fix it, and has been fully removed; we do not modify core
  // moos-ivp. Do not re-add extrap_policy on its own: it glides the icon
  // forward between reports, i.e. it smooths from positions that can still
  // jump backward without the guard. Viewer runs stock.

  hash_delta           = 50
  hash_shade           = 0.22
  hash_viewable        = true

  trails_point_size    = 1
  circle_viewable_all  = true

  appcast_viewable     = true
  appcast_color_scheme = indigo
  nodes_font_size      = large
  procs_font_size      = large
  appcast_font_size    = medium

  scope = NODE_REPORT
  scope = DEPLOY_ALL
  scope = MIO_CMD

  button_one   = DEPLOY  # DEPLOY_ALL=true
  button_one   = MOOS_MANUAL_OVERRIDE_ALL=false
  button_one   = RETURN_ALL=false
  button_one   = STATION_KEEP_ALL=false

  button_two   = RETURN  # RETURN_ALL=true
  button_two   = STATION_KEEP_ALL=false

  button_three = ALL-STOP # DEPLOY_ALL=false

  // DISPERSE / ASSEMBLE. These post a shoreside-only command var --
  // pArrivalSync picks the corner assignment and only then sends each
  // boat its own DISPERSE_<V> + DISPERSE_UPDATE_<V>. (Never post
  // DISPERSE_ALL directly: that would reach the boats with no corner set.)
  button_four  = DISPERSE # DISPERSE_CMD=true
  button_five  = ASSEMBLE # DISPERSE_CMD=false

  // MIO / END MIO. Shoreside-only command var: pArrivalSync picks the closest
  // boat, sends it to the station; the other keeps orbiting alone. END MIO
  // recalls it and the two re-form 180 deg apart.
  button_six   = MIO # MIO_CMD=true
  button_seven = END-MIO # MIO_CMD=false
}

//--------------------------------------------------------
// uProcessWatch config block

ProcessConfig = uProcessWatch
{
  AppTick   = 1
  CommsTick = 1

  allow_retractions = true
  watch_all = true

  nowatch = uXMS*
  nowatch = uPokeDB*
  nowatch = uMAC*

  summary_wait = 12
}
